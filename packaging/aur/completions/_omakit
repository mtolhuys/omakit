#compdef omakit
# omakit completion for zsh. Generated by `omakit setup` from
# marketplace pin 38060f89d2a10b1f9b6b5afe8e226451e8a5b3f6; the categories and tags
# below are that pin's submission form. Regenerate it by running setup
# again.

_omakit() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  local -a commands categories tags shells
  commands=(
    'setup:First run, in one command\: check the environment, fetch the pinned marketplace checkout, and say what to try first.'
    'pin:Fetch or verify the pinned marketplace checkout in the user cache\: $XDG_CACHE_HOME/omakit/marketplace, or ~/.cache/omakit/marketplace.'
    'submit:Every check that is knowable before submitting, the resolved commit, and the exact issue title and body.'
    'watch:Compare the commit the marketplace validated on a submission issue with the plugin repository'\''s current default-branch HEAD, and say what makes it validate a newer one.'
    'verify:The official marketplace security baseline over the local Git transport, reported verbatim beside the pin identity.'
    'help:The operating instructions for a coding agent, printed from skills/, so an agent can read the contract out of the tool instead of the repository.'
    'upgrade:Fast-forward this checkout of omakit itself.'
    'doctor:What is installed, what is pinned, and what has moved since.'
    'parity:The official baseline over GitHub versus the local transport on real listed repositories; a packaged install requires --out for evidence.'
  )
  categories=('Appearance' 'Desktop' 'Developer Tools' 'Hardware' 'Kids' 'Productivity' 'System' 'Widgets' 'Other')
  tags=('ai' 'bar' 'education' 'games' 'hyprland' 'kids' 'launcher' 'media' 'power-management' 'quickshell' 'security' 'system' 'workspaces')
  _arguments -C '1:command:->command' '*::arguments:->arguments'
  case "$state" in
  command)
    _describe -t commands 'omakit command' commands
    ;;
  arguments)
    case "$line[1]" in
    setup)
      ;;
    pin)
      ;;
    submit)
      _arguments '--category:category:{compadd -a categories}' '--tags:tags:{_values -s , tag $tags}' '--notes:text:' '--suggest-tag:text:' '--name:text:' '--offline' '--allow-dirty' '--json' '--out:file:_files' '1:target:_directories'
      ;;
    watch)
      _arguments '--json'
      ;;
    verify)
      _arguments '--allow-dirty' '--out:file:_files' '1:target:_directories'
      ;;
    help)
      _arguments '--agent'
      ;;
    upgrade)
      _arguments '--dry-run'
      ;;
    doctor)
      _arguments '--offline' '--json'
      ;;
    parity)
      _arguments '--count:text:' '--offset:text:' '--out:file:_files'
      ;;
    esac
    ;;
  esac
}

_omakit "$@"
