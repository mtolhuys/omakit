+qmp_pointer_move() {
+  local width="$1" height="$2" x="$3" y="$4" qx qy response
+
+  if ((width < 2 || height < 2 || x < 0 || y < 0 || x >= width || y >= height)); then
+    printf 'invalid QMP pointer geometry: viewport=%sx%s point=%s,%s\n' \
+      "$width" "$height" "$x" "$y" >&2
+    return 2
+  fi
+  qx=$((x * 32767 / (width - 1)))
+  qy=$((y * 32767 / (height - 1)))
+  response=$(qmp "\"input-send-event\", \"arguments\": {\"events\": [
+    {\"type\":\"abs\",\"data\":{\"axis\":\"x\",\"value\":$qx}},
+    {\"type\":\"abs\",\"data\":{\"axis\":\"y\",\"value\":$qy}}
+  ]}")
+  if grep -q '"error"' <<<"$response"; then
+    printf 'QMP pointer move failed: %s\n' "$response" >&2
+    return 1
+  fi
+}
+
+qmp_pointer_tap() {
+  local width="$1" height="$2" x="$3" y="$4" button="${5:-left}" response
+
+  case $button in
+    left | right | middle) ;;
+    *)
+      printf 'invalid QMP pointer button: %s\n' "$button" >&2
+      return 2
+      ;;
+  esac
+  qmp_pointer_move "$width" "$height" 1 1
+  sleep 0.1
+  qmp_pointer_move "$width" "$height" "$x" "$y"
+  sleep 0.1
+  response=$(qmp "\"input-send-event\", \"arguments\": {\"events\": [
+    {\"type\":\"btn\",\"data\":{\"down\":true,\"button\":\"$button\"}}
+  ]}")
+  grep -q '"error"' <<<"$response" && return 1
+  sleep 0.12
+  response=$(qmp "\"input-send-event\", \"arguments\": {\"events\": [
+    {\"type\":\"btn\",\"data\":{\"down\":false,\"button\":\"$button\"}}
+  ]}")
+  grep -q '"error"' <<<"$response" && return 1
+  sleep 0.4
+}
