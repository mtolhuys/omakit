{
  "name": "omakit",
  "version": "0.5.1",
  "description": "The plumbing Omarchy plugin reviews block most, built and tested once: a Run block and a Store block a plugin copies into its own tree, and the marketplace's own checks run locally. Every line measured against one week of review comments; posts nothing; zero dependencies.",
  "license": "MIT",
  "author": "Maarten Tolhuijs",
  "keywords": [
    "omarchy",
    "quattro",
    "plugin",
    "marketplace",
    "building-blocks",
    "qml",
    "quickshell",
    "preflight",
    "cli",
    "agent"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "omakit": "bin/omakit"
  },
  "scripts": {
    "pin": "node tools/marketplace/cli.mjs pin",
    "test": "node --test tests/unit/*.test.mjs",
    "parity": "node tools/marketplace/cli.mjs parity --count 30",
    "doctor": "node tools/marketplace/cli.mjs doctor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtolhuys/omakit.git"
  },
  "files": [
    "bin",
    "tools",
    "skills",
    "blocks",
    "tests/parity/corpus.mjs",
    "tests/parity/run.mjs"
  ]
}
