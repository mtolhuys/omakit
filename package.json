{
  "name": "omakit",
  "version": "0.5.1",
  "description": "Build it, check it, prove it.",
  "license": "MIT",
  "author": "Maarten Tolhuijs",
  "keywords": [
    "omarchy",
    "quattro",
    "plugin",
    "marketplace",
    "building-blocks",
    "qml",
    "quickshell",
    "preflight",
    "cli",
    "agent"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "omakit": "bin/omakit"
  },
  "scripts": {
    "pin": "node tools/marketplace/cli.mjs pin",
    "test": "node --test --test-timeout=180000 tests/unit/*.test.mjs",
    "parity": "node tools/marketplace/cli.mjs parity --count 30",
    "doctor": "node tools/marketplace/cli.mjs doctor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtolhuys/omakit.git"
  },
  "files": [
    "bin",
    "tools",
    "skills",
    "blocks",
    "tests/parity/corpus.mjs",
    "tests/parity/run.mjs",
    "tests/lab",
    "tests/fixtures/weigh"
  ]
}
